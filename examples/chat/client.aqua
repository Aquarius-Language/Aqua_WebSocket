# 聊天室用戶端（桌面、網頁、Android）：連線後每兩秒說一句話，並印出收到的訊息。
# Chat client (desktop, web, Android): says something every two seconds and prints messages.
變數 通訊 = 匯入("AquaWebSocket");
變數 主機 = 通訊.頁面主機();
如果 (主機 == "") { 主機 = "127.0.0.1"; }
變數 用戶端 = 通訊.連接並設定("ws://" + 主機 + ":8081/", {"自動重連": 真});
變數 名字 = "訪客" + 通訊.隨機十六進位(2);
用戶端.當開啟(函式() { 印出("已連線 / connected as", 名字); });
用戶端.當JSON(函式(訊息) {
    如果 (訊息["system"] != [][0]) { 印出("[系統 / system]", 訊息["system"]); }
    否則 { 印出("#" + 字串.轉文字(訊息["from"]), 訊息["text"]); }
});
用戶端.當關閉(函式(代碼, 原因) { 印出("連線中斷，自動重連中 / disconnected, reconnecting", 代碼); });
變數 下次 = 目前時間() + 1000;
變數 句子 = ["大家好！", "Hello from Aquarius", "星泉 WebSocket 運作中", "再見 / bye"];
變數 已說 = 0;
迴圈 (變數 輪 = 0; 已說 < 長度(句子); 輪++) {
    用戶端.等待(50);
    如果 (目前時間() >= 下次 && 用戶端.已連線()) {
        用戶端.傳送(名字 + ": " + 句子[已說]);
        已說++;
        下次 = 目前時間() + 2000;
    }
}
用戶端.等待(500);
用戶端.關閉();
