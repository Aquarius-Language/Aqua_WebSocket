##
Aqua_WebSocket 伺服器物件（每次建立伺服器都會匯入一份獨立實例）。
Server object template: every CreateServer call imports an independent instance.
##
變數 空 = [][0];
變數 序列化 = 匯入("序列化");
變數 _核心 = 空;
變數 _開啟 = 假;
變數 _停止 = 假;
變數 _當連線 = 空;
變數 _當訊息 = 空;
變數 _當二進位 = 空;
變數 _當關閉 = 空;
變數 _當錯誤 = 空;
變數 _事件佇列 = [];
變數 _連線們 = [];
變數 _連線資訊 = {};

# 公開欄位（雙語）。 / Public fields (bilingual).
變數 編號 = 0;
變數 Id = 0;
變數 連接埠 = 0;
變數 Port = 0;
變數 位址 = "";
變數 Address = "";

變數 內部初始化 = 函式(核心, 選項) {
    _核心 = 核心;
    變數 值 = 核心["選項值"];
    變數 請求 = {
        "host": 值(選項, "host", "主機", "0.0.0.0"),
        "port": 值(選項, "port", "連接埠", 8081),
        "path": 值(選項, "path", "路徑", ""),
        "origins": 值(選項, "origins", "來源", []),
        "protocols": 值(選項, "protocols", "子協定", []),
        "maxMessage": 值(選項, "maxMessage", "訊息上限", 524288),
        "maxConnections": 值(選項, "maxConnections", "連線上限", 256),
        "pingInterval": 值(選項, "pingInterval", "心跳間隔", 25000)
    };
    變數 結果 = 核心["呼叫"]("aqws_listen", 請求);
    如果 (結果["error"] != 空) {
        回傳 錯誤("Aqua_WebSocket 無法啟動伺服器 / cannot start server: " + 結果["error"]);
    }
    編號 = 結果["server"]; Id = 編號;
    連接埠 = 結果["port"]; Port = 連接埠;
    位址 = 結果["address"]; Address = 位址;
    _開啟 = 真;
    核心["註冊"](編號, 匯出物件());
    回傳 真;
};

# 以錯誤值終止（星泉執行期錯誤）。 / Raise a runtime error.
變數 錯誤 = 函式(訊息) {
    印出(訊息);
    回傳 [][0]["error"];
};

# 匯入後的模組本身就是物件；註冊時需要模組參照，因此由實例提供存取函式。
# The instance needs a reference to its own module; the core passes it via 設定自身.
變數 _自身 = 空;
變數 設定自身 = 函式(模組) { _自身 = 模組; };
變數 匯出物件 = 函式() { _自身; };

# ---- 事件回呼 / Event callbacks ----
變數 當連線, OnOpen = 函式(回呼) { _當連線 = 回呼; };
變數 當訊息, OnMessage = 函式(回呼) { _當訊息 = 回呼; };
變數 當二進位, OnBinary = 函式(回呼) { _當二進位 = 回呼; };
變數 當關閉, OnClose = 函式(回呼) { _當關閉 = 回呼; };
變數 當錯誤, OnError = 函式(回呼) { _當錯誤 = 回呼; };

變數 內部接收事件 = 函式(事件) {
    變數 類型 = 事件["type"];
    變數 連線 = 事件["conn"];
    變數 已處理 = 假;
    如果 (類型 == "open") {
        陣列.追加(_連線們, 連線);
        _連線資訊[連線] = 事件;
        如果 (_當連線 != 空) { _當連線(連線, 事件); 已處理 = 真; }
    } 否則如果 (類型 == "message") {
        如果 (_當訊息 != 空) { _當訊息(連線, 事件["text"]); 已處理 = 真; }
    } 否則如果 (類型 == "binary") {
        如果 (_當二進位 != 空) { _當二進位(連線, 事件["bytes"]); 已處理 = 真; }
    } 否則如果 (類型 == "close") {
        變數 位置 = 陣列.尋找(_連線們, 連線);
        如果 (位置 >= 0) { 陣列.刪除(_連線們, 位置, 位置 + 1); }
        _連線資訊[連線] = 空;
        如果 (_當關閉 != 空) { _當關閉(連線, 事件["code"], 事件["reason"]); 已處理 = 真; }
    } 否則如果 (類型 == "error") {
        如果 (_當錯誤 != 空) { _當錯誤(事件["message"]); 已處理 = 真; }
    }
    如果 (!已處理) {
        如果 (長度(_事件佇列) < 10000) { 陣列.追加(_事件佇列, 事件); }
    }
};
變數 內部計時 = 函式() { 假; };

# 輪詢：處理網路事件並回傳尚未被回呼處理的事件陣列。
# Poll: process network events; returns events that no callback handled.
變數 等待, Wait = 函式(毫秒) {
    _核心["輪詢全部"](毫秒);
    變數 結果 = _事件佇列;
    _事件佇列 = [];
    回傳 結果;
};
變數 輪詢, Poll = 函式() { 等待(0); };

# 持續服務直到 停止() 或每輪回呼回傳 假。 / Serve until Stop() or the tick callback returns false.
變數 執行, Run = 函式(每輪回呼) {
    _停止 = 假;
    迴圈 (變數 輪 = 0; !_停止; 輪++) {
        等待(10);
        如果 (每輪回呼 != 空) {
            變數 繼續 = 每輪回呼();
            如果 (繼續 == 假) { _停止 = 真; }
        }
    }
    回傳 真;
};
變數 停止, Stop = 函式() { _停止 = 真; };

# ---- 傳送 / Sending ----
變數 傳送, Send = 函式(連線, 文字) {
    回傳 _核心["呼叫"]("aqws_send", {"conn": 連線, "text": 文字})["sent"] > 0;
};
變數 傳送JSON, SendJSON = 函式(連線, 值) { 傳送(連線, 序列化.JSON序列化(值)); };
變數 傳送位元組, SendBytes = 函式(連線, 位元組) {
    回傳 _核心["呼叫"]("aqws_send", {"conn": 連線, "bytes": 位元組})["sent"] > 0;
};
變數 群發, SendMany = 函式(連線們, 文字) {
    回傳 _核心["呼叫"]("aqws_send", {"conns": 連線們, "text": 文字})["sent"];
};
變數 廣播, Broadcast = 函式(文字) {
    回傳 _核心["呼叫"]("aqws_broadcast", {"server": 編號, "text": 文字, "except": 0})["sent"];
};
變數 廣播除外, BroadcastExcept = 函式(文字, 排除連線) {
    回傳 _核心["呼叫"]("aqws_broadcast", {"server": 編號, "text": 文字, "except": 排除連線})["sent"];
};
變數 廣播JSON, BroadcastJSON = 函式(值) { 廣播(序列化.JSON序列化(值)); };

# ---- 連線管理 / Connection management ----
變數 中斷連線, Disconnect = 函式(連線, 代碼, 原因) {
    回傳 _核心["呼叫"]("aqws_close", {"conn": 連線, "code": 代碼, "reason": 原因})["ok"];
};
變數 連線列表, Connections = 函式() { 陣列.克隆(_連線們); };
變數 連線數, ConnectionCount = 函式() { 長度(_連線們); };
變數 連線資訊, ConnectionInfo = 函式(連線) { _連線資訊[連線]; };
變數 是否開啟, IsOpen = 函式() { _開啟; };

變數 關閉, Close = 函式() {
    如果 (!_開啟) { 回傳 假; }
    _核心["呼叫"]("aqws_close_server", {"server": 編號, "closeConnections": 真});
    # 讓關閉訊框送出。 / Let close frames flush.
    _核心["輪詢全部"](20);
    _核心["取消註冊"](編號);
    _開啟 = 假;
    _停止 = 真;
    回傳 真;
};
