##
Aqua_WebSocket 伺服器物件（每次建立伺服器都會匯入一份獨立實例）。每條連線由「網路」伺服器的一個處理工作負責：
升級成 WebSocket 後持續接收，把事件交給核心（輪詢或立即分派）。
Server object template: every CreateServer call imports an independent instance. Each connection is one handler
task of a Network server: it upgrades to WebSocket and keeps receiving, handing events to the core.
##
變數 空 = [][0];
變數 序列化 = 匯入("序列化");
變數 _核心 = 空;
變數 _網路 = 空;
變數 _網路伺服器 = 空;
變數 _自有伺服器 = 假;
變數 _開啟 = 假;
變數 _停止 = 假;
變數 _立即 = 假;
變數 _結束承諾 = 空;
變數 _服務 = 空;
變數 _子協定 = [];
變數 _連線上限 = 256;
變數 _當連線 = 空;
變數 _當訊息 = 空;
變數 _當二進位 = 空;
變數 _當關閉 = 空;
變數 _當錯誤 = 空;
變數 _事件佇列 = [];
變數 _連線們 = [];
變數 _連線資訊 = {};
變數 _通訊端 = {};
變數 _房間 = {};

# 公開欄位（雙語）。 / Public fields (bilingual).
變數 編號 = 0;
變數 Id = 0;
變數 連接埠 = 0;
變數 Port = 0;
變數 位址 = "";
變數 Address = "";

變數 _自身 = 空;
變數 設定自身 = 函式(模組) { _自身 = 模組; };
變數 匯出物件 = 函式() { _自身; };

# 以錯誤值終止（星泉執行期錯誤）。 / Raise a runtime error.
變數 錯誤 = 函式(訊息) {
    印出(訊息);
    回傳 [][0]["error"];
};

變數 _查詢字串 = 函式(網址) {
    變數 位置 = 字串.尋找(網址, "?");
    如果 (位置 < 0) { 回傳 ""; }
    回傳 字串.切片(網址, 位置 + 1, 長度(網址));
};

# 一條連線：升級、登記、接收直到關閉。 / One connection: upgrade, register, receive until closed.
變數 _處理連線 = 非同步 函式(請求, 回應) {
    如果 (!_開啟) { 回應.錯誤(503); 回傳 空; }
    如果 (字串.轉小寫(請求.取得標頭("Upgrade")) != "websocket") { 回應.錯誤(426, "Upgrade Required / 需要 WebSocket"); 回傳 空; }
    如果 (長度(_連線們) >= _連線上限) { 回應.錯誤(503, "Too many connections / 連線過多"); 回傳 空; }
    變數 通訊端 = 回應.升級網頁通訊端(_子協定);
    變數 連線 = _核心["新編號"]();
    _通訊端[連線] = 通訊端;
    _核心["推入"]({"type": "open", "server": 編號, "conn": 連線, "remote": 請求.遠端位址, "path": 請求.路徑,
        "query": _查詢字串(請求.網址), "origin": 請求.取得標頭("Origin"), "protocol": 通訊端.子協定});
    迴圈 (;;) {
        變數 訊息 = 等待 通訊端.非同步接收().捕捉(函式(原因) { 回傳 空; });
        如果 (訊息 == 空) {
            _通訊端[連線] = 空;
            _核心["推入"]({"type": "close", "server": 編號, "conn": 連線, "code": 1006, "reason": ""});
            中斷;
        }
        如果 (訊息.已關閉) {
            _通訊端[連線] = 空;
            _核心["推入"]({"type": "close", "server": 編號, "conn": 連線, "code": 訊息.關閉代碼, "reason": 訊息.關閉原因});
            中斷;
        }
        如果 (訊息.是文字) { _核心["推入"]({"type": "message", "server": 編號, "conn": 連線, "text": 訊息.文字}); }
        否則 { _核心["推入"]({"type": "binary", "server": 編號, "conn": 連線, "bytes": 訊息.資料}); }
    }
    回傳 空;
};

變數 內部初始化 = 函式(核心, 選項, 網路伺服器) {
    _核心 = 核心;
    _網路 = 核心["網路"];
    變數 值 = 核心["選項值"];
    變數 主機 = 值(選項, "host", "主機", "0.0.0.0");
    變數 埠 = 值(選項, "port", "連接埠", 8081);
    變數 路徑 = 值(選項, "path", "路徑", "");
    變數 來源 = 值(選項, "origins", "來源", []);
    _子協定 = 值(選項, "protocols", "子協定", []);
    _連線上限 = 值(選項, "maxConnections", "連線上限", 256);
    變數 憑證 = 值(選項, "certificate", "憑證", "");
    _網路伺服器 = 網路伺服器;
    如果 (_網路伺服器 == 空) {
        變數 協定 = "http";
        變數 設定 = {"maxBodyBytes": 值(選項, "maxMessage", "訊息上限", 524288)};
        如果 (憑證 != "") {
            協定 = "https";
            設定["certificate"] = 憑證;
            設定["certificatePassword"] = 值(選項, "certificatePassword", "憑證密碼", "");
        }
        變數 結果 = _網路.嘗試(函式() { 回傳 _網路.監聽(協定 + "://" + 主機 + ":" + 字串.轉文字(埠), 設定); });
        如果 (!結果.成功) { 回傳 錯誤("Aqua_WebSocket 無法啟動伺服器 / cannot start server: " + 結果.錯誤.訊息); }
        _網路伺服器 = 結果.值;
        _自有伺服器 = 真;
        # 未列出來源時接受所有來源的瀏覽器連線。 / Without origins, browsers from any origin may connect.
        如果 (長度(來源) == 0) { _網路伺服器.跨來源(["*"]); } 否則 { _網路伺服器.跨來源(來源); }
    }
    如果 (路徑 == "") { _網路伺服器.處理("GET /{path...}", _處理連線); }
    否則 { _網路伺服器.處理("GET " + 路徑, _處理連線); }
    變數 網址 = _網路.解析網址(_網路伺服器.位址);
    連接埠 = 網址.連接埠; Port = 連接埠;
    變數 協定名 = "ws://";
    如果 (網址.協定 == "https") { 協定名 = "wss://"; }
    位址 = 協定名 + 網址.主機 + ":" + 字串.轉文字(連接埠); Address = 位址;
    編號 = 核心["新編號"](); Id = 編號;
    _開啟 = 真;
    核心["註冊"](編號, 匯出物件());
    如果 (_自有伺服器) { _服務 = _網路伺服器.非同步服務(); }
    回傳 真;
};

# ---- 事件回呼 / Event callbacks ----
變數 當連線, OnOpen = 函式(回呼) { _當連線 = 回呼; };
變數 當訊息, OnMessage = 函式(回呼) { _當訊息 = 回呼; };
變數 當二進位, OnBinary = 函式(回呼) { _當二進位 = 回呼; };
變數 當關閉, OnClose = 函式(回呼) { _當關閉 = 回呼; };
變數 當錯誤, OnError = 函式(回呼) { _當錯誤 = 回呼; };

變數 內部立即 = 函式() { _立即; };

變數 內部接收事件 = 函式(事件) {
    變數 類型 = 事件["type"];
    變數 連線 = 事件["conn"];
    變數 已處理 = 假;
    如果 (類型 == "open") {
        陣列.追加(_連線們, 連線);
        _連線資訊[連線] = 事件;
        如果 (_當連線 != 空) { _當連線(連線, 事件); 已處理 = 真; }
    } 否則如果 (類型 == "message") {
        如果 (_當訊息 != 空) { _當訊息(連線, 事件["text"]); 已處理 = 真; }
    } 否則如果 (類型 == "binary") {
        如果 (_當二進位 != 空) { _當二進位(連線, 事件["bytes"]); 已處理 = 真; }
    } 否則如果 (類型 == "close") {
        變數 位置 = 陣列.尋找(_連線們, 連線);
        如果 (位置 >= 0) { 陣列.刪除(_連線們, 位置, 位置 + 1); }
        _連線資訊[連線] = 空;
        離開所有房間(連線);
        如果 (_當關閉 != 空) { _當關閉(連線, 事件["code"], 事件["reason"]); 已處理 = 真; }
    } 否則如果 (類型 == "error") {
        如果 (_當錯誤 != 空) { _當錯誤(事件["message"]); 已處理 = 真; }
    }
    如果 (!已處理 && !_立即) {
        如果 (長度(_事件佇列) < 10000) { 陣列.追加(_事件佇列, 事件); }
    }
};
變數 內部計時 = 函式() { 假; };

# 輪詢：處理網路事件並回傳尚未被回呼處理的事件陣列。
# Poll: process network events; returns events that no callback handled.
變數 等待, Wait = 函式(毫秒) {
    _核心["輪詢全部"](毫秒);
    變數 結果 = _事件佇列;
    _事件佇列 = [];
    回傳 結果;
};
變數 輪詢, Poll = 函式() { 等待(0); };

# 持續服務直到 停止() 或每輪回呼回傳 假。 / Serve until Stop() or the tick callback returns false.
變數 執行, Run = 函式(每輪回呼) {
    _停止 = 假;
    迴圈 (變數 輪 = 0; !_停止; 輪++) {
        等待(10);
        如果 (每輪回呼 != 空) {
            變數 仍要 = 每輪回呼();
            如果 (仍要 == 假) { _停止 = 真; }
        }
    }
    回傳 真;
};
變數 停止, Stop = 函式() {
    _停止 = 真;
    如果 (_結束承諾 != 空) { 變數 完成 = _結束承諾; _結束承諾 = 空; 完成(真); }
    回傳 真;
};

# 非同步執行：回呼在事件到達時立即執行（可為非同步函式）；承諾在 停止() 或 關閉() 後完成。
# RunAsync: callbacks (async ones too) run as events arrive; the promise settles after Stop() or Close().
變數 非同步執行, RunAsync = 函式() {
    _立即 = 真;
    _停止 = 假;
    # 先分派輪詢之前已到達的事件。 / Dispatch what arrived before.
    _核心["輪詢全部"](0);
    回傳 承諾.建立(函式(完成, 拒絕) { _結束承諾 = 完成; });
};

# ---- 傳送 / Sending ----
變數 _傳 = 函式(連線, 文字, 位元組) {
    變數 通訊端 = _通訊端[連線];
    如果 (通訊端 == 空) { 回傳 假; }
    回傳 _網路.嘗試(函式() { 如果 (位元組 == 空) { 通訊端.傳送文字(文字); } 否則 { 通訊端.傳送位元組(位元組); } }).成功;
};
變數 傳送, Send = 函式(連線, 文字) { _傳(連線, 文字, 空); };
變數 傳送JSON, SendJSON = 函式(連線, 值) { 傳送(連線, 序列化.JSON序列化(值)); };
變數 傳送位元組, SendBytes = 函式(連線, 位元組) { _傳(連線, "", 位元組); };
變數 群發, SendMany = 函式(連線們, 文字) {
    變數 數量 = 0;
    迴圈 (變數 索引 = 0; 索引 < 長度(連線們); 索引++) { 如果 (傳送(連線們[索引], 文字)) { 數量++; } }
    回傳 數量;
};
變數 廣播除外, BroadcastExcept = 函式(文字, 排除連線) {
    變數 數量 = 0;
    變數 快照 = 陣列.克隆(_連線們);
    迴圈 (變數 索引 = 0; 索引 < 長度(快照); 索引++) {
        如果 (快照[索引] != 排除連線) { 如果 (傳送(快照[索引], 文字)) { 數量++; } }
    }
    回傳 數量;
};
變數 廣播, Broadcast = 函式(文字) { 廣播除外(文字, 0); };
變數 廣播JSON, BroadcastJSON = 函式(值) { 廣播(序列化.JSON序列化(值)); };

# ---- 房間 / Rooms ----
變數 加入房間, Join = 函式(連線, 房間) {
    變數 成員 = _房間[房間];
    如果 (成員 == 空) { 成員 = []; _房間[房間] = 成員; }
    如果 (陣列.尋找(成員, 連線) < 0) { 陣列.追加(成員, 連線); }
    回傳 真;
};
變數 離開房間, Leave = 函式(連線, 房間) {
    變數 成員 = _房間[房間];
    如果 (成員 == 空) { 回傳 假; }
    變數 位置 = 陣列.尋找(成員, 連線);
    如果 (位置 < 0) { 回傳 假; }
    陣列.刪除(成員, 位置, 位置 + 1);
    如果 (長度(成員) == 0) { 雜湊.刪除鍵(_房間, 房間); }
    回傳 真;
};
變數 離開所有房間, LeaveAll = 函式(連線) {
    變數 名稱們 = 雜湊.鍵列表(_房間);
    迴圈 (變數 索引 = 0; 索引 < 長度(名稱們); 索引++) { 離開房間(連線, 名稱們[索引]); }
    回傳 真;
};
變數 房間成員, RoomMembers = 函式(房間) {
    變數 成員 = _房間[房間];
    如果 (成員 == 空) { 回傳 []; }
    回傳 陣列.克隆(成員);
};
變數 房間列表, Rooms = 函式() { 雜湊.鍵列表(_房間); };
變數 房間廣播除外, BroadcastToExcept = 函式(房間, 文字, 排除連線) {
    變數 成員 = 房間成員(房間);
    變數 數量 = 0;
    迴圈 (變數 索引 = 0; 索引 < 長度(成員); 索引++) {
        如果 (成員[索引] != 排除連線) { 如果 (傳送(成員[索引], 文字)) { 數量++; } }
    }
    回傳 數量;
};
變數 房間廣播, BroadcastTo = 函式(房間, 文字) { 房間廣播除外(房間, 文字, 0); };

# ---- 連線管理 / Connection management ----
變數 中斷連線, Disconnect = 函式(連線, 代碼, 原因) {
    變數 通訊端 = _通訊端[連線];
    如果 (通訊端 == 空) { 回傳 假; }
    如果 (代碼 == 空) { 代碼 = 1000; }
    如果 (原因 == 空) { 原因 = ""; }
    回傳 _網路.嘗試(函式() { 通訊端.關閉(代碼, 原因); }).成功;
};
變數 連線列表, Connections = 函式() { 陣列.克隆(_連線們); };
變數 連線數, ConnectionCount = 函式() { 長度(_連線們); };
變數 連線資訊, ConnectionInfo = 函式(連線) { _連線資訊[連線]; };
變數 是否開啟, IsOpen = 函式() { _開啟; };
# 底層的「網路」伺服器（可再加 HTTP 路由）。 / The underlying Network server (add HTTP routes to it).
變數 網路伺服器, HttpServer = 函式() { _網路伺服器; };

變數 關閉, Close = 函式() {
    如果 (!_開啟) { 回傳 假; }
    _開啟 = 假;
    變數 快照 = 陣列.克隆(_連線們);
    迴圈 (變數 索引 = 0; 索引 < 長度(快照); 索引++) { 中斷連線(快照[索引], 1001, "server closing"); }
    # 讓關閉訊框送出、關閉事件到達。 / Let close frames flush and close events arrive.
    變數 期限 = 目前時間() + 500;
    迴圈 (; 長度(_連線們) > 0 && 目前時間() < 期限;) { _核心["輪詢全部"](10); }
    如果 (_自有伺服器) { _網路伺服器.關閉(); }
    _核心["取消註冊"](編號);
    停止();
    回傳 真;
};
