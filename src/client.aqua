##
Aqua_WebSocket 用戶端物件（每次連線都會匯入一份獨立實例）。
Client object template: every Connect call imports an independent instance.
支援自動重新連線與連線中的訊息佇列。 / Supports auto-reconnect and queueing while connecting.
##
變數 空 = [][0];
變數 序列化 = 匯入("序列化");
變數 _核心 = 空;
變數 _自身 = 空;
變數 _解析 = 空;
變數 _網址 = "";
變數 _選項 = {};
變數 _位址 = "";
變數 _連線 = 0;
變數 _狀態 = "closed";
變數 _使用者關閉 = 假;
變數 _自動重連 = 假;
變數 _重連間隔 = 2000;
變數 _下次重連 = -1;
變數 _佇列中 = 真;
變數 _待送 = [];
變數 _當開啟 = 空;
變數 _當訊息 = 空;
變數 _當JSON = 空;
變數 _當二進位 = 空;
變數 _當關閉 = 空;
變數 _當錯誤 = 空;
變數 _事件佇列 = [];
變數 重連次數 = 0;
變數 ReconnectCount = 0;
變數 最後錯誤 = "";
變數 LastError = "";

變數 設定自身 = 函式(模組) { _自身 = 模組; };

變數 _記錄錯誤 = 函式(訊息) {
    最後錯誤 = 訊息; LastError = 訊息;
    如果 (_當錯誤 != 空) { _當錯誤(訊息); }
    否則 { 陣列.追加(_事件佇列, {"type": "error", "類型": "錯誤", "message": 訊息, "訊息": 訊息}); }
};

變數 _開始連線 = 函式() {
    變數 值 = _核心["選項值"];
    變數 請求 = {
        "url": _網址,
        "protocols": 值(_選項, "protocols", "子協定", []),
        "origin": 值(_選項, "origin", "來源", ""),
        "headers": 值(_選項, "headers", "標頭", {}),
        "timeout": 值(_選項, "timeout", "逾時", 10000),
        "maxMessage": 值(_選項, "maxMessage", "訊息上限", 524288),
        "pingInterval": 值(_選項, "pingInterval", "心跳間隔", 25000)
    };
    如果 (_位址 != "") { 請求["address"] = _位址; }
    變數 結果 = _核心["呼叫"]("aqws_connect", 請求);
    如果 (結果["needsResolve"] == 真) {
        # 原生引擎不含 DNS：用星泉網路函式庫解析後重試。 / Resolve with the Network library, then retry.
        _位址 = _解析(結果["host"]);
        如果 (_位址 == 空) { _位址 = ""; _記錄錯誤("無法解析主機 / cannot resolve host"); _狀態 = "closed"; 回傳 假; }
        請求["address"] = _位址;
        結果 = _核心["呼叫"]("aqws_connect", 請求);
    }
    如果 (結果["error"] != 空) {
        _記錄錯誤(結果["error"]);
        _狀態 = "closed";
        如果 (_自動重連 && !_使用者關閉) { _下次重連 = 目前時間() + _重連間隔; }
        回傳 假;
    }
    _連線 = 結果["conn"];
    _狀態 = "connecting";
    _核心["註冊"](_連線, _自身);
    回傳 真;
};

變數 內部初始化 = 函式(核心, 網址, 選項, 解析函式) {
    _核心 = 核心; _網址 = 網址; _選項 = 選項; _解析 = 解析函式;
    變數 值 = 核心["選項值"];
    _自動重連 = 值(選項, "autoReconnect", "自動重連", 假);
    _重連間隔 = 值(選項, "reconnectDelay", "重連間隔", 2000);
    _佇列中 = 值(選項, "queueWhileConnecting", "連線中佇列", 真);
    _開始連線();
    回傳 真;
};

# ---- 事件回呼 / Event callbacks ----
變數 當開啟, OnOpen = 函式(回呼) { _當開啟 = 回呼; };
變數 當訊息, OnMessage = 函式(回呼) { _當訊息 = 回呼; };
變數 當JSON, OnJSON = 函式(回呼) { _當JSON = 回呼; };
變數 當二進位, OnBinary = 函式(回呼) { _當二進位 = 回呼; };
變數 當關閉, OnClose = 函式(回呼) { _當關閉 = 回呼; };
變數 當錯誤, OnError = 函式(回呼) { _當錯誤 = 回呼; };

變數 內部接收事件 = 函式(事件) {
    變數 類型 = 事件["type"];
    變數 已處理 = 假;
    如果 (類型 == "open") {
        _狀態 = "open";
        # 送出連線期間排隊的訊息。 / Flush messages queued while connecting.
        變數 待送 = _待送;
        _待送 = [];
        迴圈 (變數 索引 = 0; 索引 < 長度(待送); 索引++) {
            變數 項目 = 待送[索引];
            項目["conn"] = _連線;
            _核心["呼叫"]("aqws_send", 項目);
        }
        如果 (_當開啟 != 空) { _當開啟(); 已處理 = 真; }
    } 否則如果 (類型 == "message") {
        如果 (_當訊息 != 空) { _當訊息(事件["text"]); 已處理 = 真; }
        如果 (_當JSON != 空) { _當JSON(序列化.解析JSON(事件["text"])); 已處理 = 真; }
    } 否則如果 (類型 == "binary") {
        如果 (_當二進位 != 空) { _當二進位(事件["bytes"]); 已處理 = 真; }
    } 否則如果 (類型 == "close") {
        _核心["取消註冊"](_連線);
        _狀態 = "closed";
        如果 (_自動重連 && !_使用者關閉) { _下次重連 = 目前時間() + _重連間隔; }
        如果 (_當關閉 != 空) { _當關閉(事件["code"], 事件["reason"]); 已處理 = 真; }
    } 否則如果 (類型 == "error") {
        最後錯誤 = 事件["message"]; LastError = 最後錯誤;
        如果 (_當錯誤 != 空) { _當錯誤(事件["message"]); 已處理 = 真; }
    }
    如果 (!已處理) {
        如果 (長度(_事件佇列) < 10000) { 陣列.追加(_事件佇列, 事件); }
    }
};

變數 內部計時 = 函式() {
    如果 (_下次重連 >= 0) {
        如果 (目前時間() >= _下次重連) {
            _下次重連 = -1;
            重連次數++; ReconnectCount = 重連次數;
            _開始連線();
        }
    }
    回傳 真;
};

# 輪詢：處理網路事件，回傳未被回呼處理的事件。 / Poll and return unhandled events.
變數 等待, Wait = 函式(毫秒) {
    _核心["輪詢全部"](毫秒);
    # 尚未註冊（等待重連）時仍需推進計時器。 / Advance timers while waiting to reconnect.
    如果 (_狀態 == "closed") { 內部計時(); }
    變數 結果 = _事件佇列;
    _事件佇列 = [];
    回傳 結果;
};
變數 輪詢, Poll = 函式() { 等待(0); };

# ---- 傳送 / Sending ----
變數 傳送, Send = 函式(文字) {
    如果 (_狀態 == "open") {
        回傳 _核心["呼叫"]("aqws_send", {"conn": _連線, "text": 文字})["sent"] > 0;
    }
    回傳 _排隊({"text": 文字});
};
# 連線中先排隊，開啟後依序送出。 / Queue while connecting; flushed in order on open.
變數 _排隊 = 函式(項目) {
    如果 (_佇列中 && !_使用者關閉) {
        如果 (長度(_待送) < 1000) { 陣列.追加(_待送, 項目); 回傳 真; }
    }
    回傳 假;
};
變數 傳送JSON, SendJSON = 函式(值) { 傳送(序列化.JSON序列化(值)); };
變數 傳送位元組, SendBytes = 函式(位元組) {
    如果 (_狀態 != "open") { 回傳 _排隊({"bytes": 位元組}); }
    回傳 _核心["呼叫"]("aqws_send", {"conn": _連線, "bytes": 位元組})["sent"] > 0;
};

# ---- 狀態 / State ----
變數 狀態, State = 函式() { _狀態; };
變數 已連線, IsOpen = 函式() { _狀態 == "open"; };
變數 網址, Url = 函式() { _網址; };
變數 連線編號, ConnectionId = 函式() { _連線; };

變數 關閉並說明, CloseWith = 函式(代碼, 原因) {
    _使用者關閉 = 真;
    _下次重連 = -1;
    如果 (_狀態 == "closed") { 回傳 假; }
    _核心["呼叫"]("aqws_close", {"conn": _連線, "code": 代碼, "reason": 原因});
    回傳 真;
};
變數 關閉, Close = 函式() { 關閉並說明(1000, ""); };
