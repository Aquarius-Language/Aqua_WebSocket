##
Aqua_WebSocket 1.0.0 — 星泉跨平台 WebSocket 函式庫 / Cross-platform WebSocket library.

桌面（Windows／Linux）：伺服器＋用戶端；Android：用戶端（亦可在區域網路當伺服器）；網頁：瀏覽器用戶端。
Desktop (Windows/Linux): server + client. Android: client (server also works on a LAN).
Web: browser client.

    變數 通訊 = 匯入("/bottles/Aqua_WebSocket/main.aqua");
    變數 伺服器 = 通訊.建立伺服器({"連接埠": 8081});
    伺服器.當訊息(函式(連線, 文字) { 伺服器.廣播(文字); });
    伺服器.執行(函式() { 真; });

所有公開函式皆提供繁體中文與英文名稱，兩者指向同一個函式。
Every public function has a Traditional Chinese and an English name bound to the same closure.
##
變數 動態 = 匯入("動態函式庫");
變數 序列化 = 匯入("序列化");
變數 空 = [][0];
變數 _目錄 = 目前工作目錄;
變數 _函式庫 = 空;
變數 _情境 = 0;
變數 _平台 = "";
變數 _可當伺服器 = 假;
變數 _引擎版本 = "";
變數 _頁面 = 空;
變數 _物件表 = {};
變數 _物件編號 = [];
變數 _網路 = 空;

變數 版本, Version = 函式() { "1.0.0"; };

# 讀取選項：同時接受英文與繁體中文鍵。 / Option lookup accepting English or Chinese keys.
變數 選項值, OptionValue = 函式(選項, 英文鍵, 中文鍵, 預設值) {
    如果 (選項 == 空) { 回傳 預設值; }
    變數 甲 = 選項[英文鍵];
    如果 (甲 != 空) { 回傳 甲; }
    變數 乙 = 選項[中文鍵];
    如果 (乙 != 空) { 回傳 乙; }
    回傳 預設值;
};

變數 _呼叫 = 函式(名稱, 請求) {
    回傳 序列化.解析JSON(_函式庫.呼叫(名稱, 序列化.JSON序列化(請求)));
};

變數 載入, Load = 函式() {
    如果 (_函式庫 == 空) {
        _函式庫 = 動態.載入({
            "windows": _目錄 + "/native/windows/aquaws.dll",
            "linux": _目錄 + "/native/linux/libaquaws.so",
            "android": "libaquaws.so",
            "web": _目錄 + "/native/web/aquaws.mjs"
        });
        變數 資訊 = _呼叫("aqws_open", {});
        _情境 = 資訊["ctx"];
        _平台 = 資訊["platform"];
        _可當伺服器 = 資訊["server"];
        _引擎版本 = 資訊["version"];
        _頁面 = 資訊["page"];
    }
    回傳 真;
};

變數 平台, Platform = 函式() { 載入(); _平台; };
變數 支援伺服器, SupportsServer = 函式() { 載入(); _可當伺服器; };
變數 引擎版本, EngineVersion = 函式() { 載入(); _引擎版本; };
# 網頁：載入此程式的網頁主機名稱（例如伺服器的 IP）；其他平台回傳空字串。
# Web: host name of the page that loaded the app (e.g. the server's IP); "" elsewhere.
變數 頁面主機, PageHost = 函式() {
    載入();
    如果 (_頁面 == 空) { 回傳 ""; }
    回傳 _頁面["host"];
};
# 網頁是否以 HTTPS 載入（此時應使用 wss://）。 / Whether the page was loaded over HTTPS.
變數 頁面安全, PageIsSecure = 函式() {
    載入();
    如果 (_頁面 == 空) { 回傳 假; }
    回傳 _頁面["secure"] == 真;
};

# 內部：給實例模組使用的核心操作。 / Internal core operations shared with instance modules.
變數 _核心呼叫 = 函式(名稱, 請求) {
    載入();
    請求["ctx"] = _情境;
    回傳 _呼叫(名稱, 請求);
};
變數 _註冊 = 函式(編號, 物件) {
    如果 (_物件表[編號] == 空) { 陣列.追加(_物件編號, 編號); }
    _物件表[編號] = 物件;
};
變數 _取消註冊 = 函式(編號) {
    _物件表[編號] = 空;
    變數 位置 = 陣列.尋找(_物件編號, 編號);
    如果 (位置 >= 0) { 陣列.刪除(_物件編號, 位置, 位置 + 1); }
};

變數 _中文類型 = 函式(類型) {
    如果 (類型 == "open") { 回傳 "開啟"; }
    如果 (類型 == "message") { 回傳 "訊息"; }
    如果 (類型 == "binary") { 回傳 "二進位"; }
    如果 (類型 == "close") { 回傳 "關閉"; }
    如果 (類型 == "error") { 回傳 "錯誤"; }
    回傳 類型;
};

# 原生事件轉成雙語事件雜湊表。 / Convert an engine event to a bilingual event hash.
變數 雙語事件, BilingualEvent = 函式(原始) {
    回傳 {
        "type": 原始["type"], "類型": _中文類型(原始["type"]),
        "conn": 原始["conn"], "連線": 原始["conn"],
        "server": 原始["server"], "伺服器": 原始["server"],
        "text": 原始["text"], "文字": 原始["text"],
        "bytes": 原始["bytes"], "位元組": 原始["bytes"],
        "code": 原始["code"], "代碼": 原始["code"],
        "reason": 原始["reason"], "原因": 原始["reason"],
        "message": 原始["message"], "訊息": 原始["message"],
        "remote": 原始["remote"], "遠端": 原始["remote"],
        "path": 原始["path"], "路徑": 原始["path"],
        "query": 原始["query"], "查詢": 原始["query"],
        "origin": 原始["origin"], "來源": 原始["origin"],
        "protocol": 原始["protocol"], "子協定": 原始["protocol"]
    };
};

# 輪詢一次並把事件分派給伺服器與用戶端物件；回傳處理的事件數。
# Poll once and dispatch events to their server/client objects; returns the event count.
變數 輪詢全部, PollAll = 函式(逾時毫秒) {
    如果 (_函式庫 == 空) { 回傳 0; }
    變數 結果 = _呼叫("aqws_poll", {"ctx": _情境, "timeout": 逾時毫秒});
    變數 事件們 = 結果["events"];
    如果 (事件們 == 空) { 回傳 0; }
    迴圈 (變數 索引 = 0; 索引 < 長度(事件們); 索引++) {
        變數 事件 = 雙語事件(事件們[索引]);
        變數 擁有者 = 空;
        如果 (事件["server"] != 0) { 擁有者 = _物件表[事件["server"]]; }
        否則 { 擁有者 = _物件表[事件["conn"]]; }
        如果 (擁有者 != 空) { 擁有者.內部接收事件(事件); }
    }
    # 讓每個物件處理計時工作（例如自動重新連線）。 / Let objects run timers (e.g. reconnects).
    變數 快照 = 陣列.克隆(_物件編號);
    迴圈 (變數 索引 = 0; 索引 < 長度(快照); 索引++) {
        變數 物件 = _物件表[快照[索引]];
        如果 (物件 != 空) { 物件.內部計時(); }
    }
    回傳 長度(事件們);
};

變數 _核心 = {
    "呼叫": _核心呼叫,
    "註冊": _註冊,
    "取消註冊": _取消註冊,
    "輪詢全部": 輪詢全部,
    "選項值": 選項值
};

# 建立 WebSocket 伺服器（桌面）。選項：連接埠/port、主機/host、路徑/path、來源/origins、
# 子協定/protocols、訊息上限/maxMessage、連線上限/maxConnections、心跳間隔/pingInterval。
# Create a WebSocket server (desktop). See README for every option.
變數 建立伺服器, CreateServer = 函式(選項) {
    載入();
    變數 伺服器 = 匯入(_目錄 + "/src/server.aqua");
    伺服器.設定自身(伺服器);
    伺服器.內部初始化(_核心, 選項);
    回傳 伺服器;
};

# 解析主機名稱（原生平台）；網頁由瀏覽器處理。 / Resolve host names on native platforms.
變數 _解析 = 函式(主機) {
    如果 (_網路 == 空) { _網路 = 匯入("網路"); }
    變數 位址們 = _網路.解析主機(主機);
    變數 選擇 = 空;
    迴圈 (變數 索引 = 0; 索引 < 長度(位址們); 索引++) {
        # 優先選擇 IPv4。 / Prefer IPv4 addresses.
        如果 (選擇 == 空 && !字串.包含(位址們[索引], ":")) { 選擇 = 位址們[索引]; }
    }
    如果 (選擇 == 空 && 長度(位址們) > 0) { 選擇 = 位址們[0]; }
    回傳 選擇;
};

# 連到 WebSocket 伺服器。 / Connect to a WebSocket server.
變數 連接並設定, ConnectWith = 函式(網址, 選項) {
    載入();
    變數 用戶端 = 匯入(_目錄 + "/src/client.aqua");
    用戶端.設定自身(用戶端);
    用戶端.內部初始化(_核心, 網址, 選項, _解析);
    回傳 用戶端;
};
變數 連接, Connect = 函式(網址) { 連接並設定(網址, {}); };

變數 隨機整數, RandomInt = 函式() {
    載入();
    回傳 _呼叫("aqws_random", {"bytes": 4})["int"];
};
變數 隨機十六進位, RandomHex = 函式(位元組數) {
    載入();
    回傳 _呼叫("aqws_random", {"bytes": 位元組數})["hex"];
};

變數 關閉全部, CloseAll = 函式() {
    如果 (_函式庫 == 空) { 回傳 假; }
    _呼叫("aqws_close_ctx", {"ctx": _情境});
    _函式庫.釋放();
    _函式庫 = 空;
    _物件表 = {};
    _物件編號 = [];
    回傳 真;
};
