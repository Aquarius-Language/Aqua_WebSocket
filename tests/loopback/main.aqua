# 桌面迴路測試：同一個程式內啟動伺服器並以兩個用戶端互傳訊息。
# Desktop loopback test: one process runs a server and two clients.
變數 通訊 = 匯入("/bottles/Aqua_WebSocket/main.aqua");
變數 文 = 字串;
變數 空 = [][0];
印出("平台 / platform:", 通訊.平台(), "伺服器 / server:", 通訊.支援伺服器());

變數 伺服器 = 通訊.建立伺服器({"主機": "127.0.0.1", "連接埠": 0, "路徑": "/聊天"});
印出("監聽 / listening:", 伺服器.位址);
變數 收到 = [];
伺服器.當連線(函式(連線, 資訊) { 伺服器.傳送JSON(連線, {"歡迎": 連線, "路徑": 資訊["路徑"]}); });
伺服器.當訊息(函式(連線, 文字) { 伺服器.廣播除外("轉送:" + 文字, 連線); });
伺服器.當二進位(函式(連線, 位元組) { 伺服器.傳送位元組(連線, 位元組); });
伺服器.當關閉(函式(連線, 代碼, 原因) { 陣列.追加(收到, "關閉:" + 文.轉文字(代碼)); });

變數 網址 = "ws://localhost:" + 文.轉文字(伺服器.連接埠) + "/聊天";
變數 甲 = 通訊.連接(網址);
變數 乙 = 通訊.ConnectWith(網址, {"autoReconnect": 假});
變數 甲訊息 = [];
變數 乙訊息 = [];
甲.當JSON(函式(值) { 陣列.追加(甲訊息, 值); });
乙.當訊息(函式(文字) { 陣列.追加(乙訊息, 文字); });
乙.當二進位(函式(位元組) { 陣列.追加(乙訊息, 位元組); });
# 連線完成前送出的訊息會排隊。 / Messages sent while connecting are queued.
甲.傳送("你好，乙");

變數 開始 = 目前時間();
變數 已送 = 假;
迴圈 (變數 輪 = 0; 目前時間() - 開始 < 3000; 輪++) {
    通訊.輪詢全部(10);
    如果 (!已送 && 乙.已連線() && 長度(乙訊息) >= 2) { 乙.傳送位元組([0, 1, 127, 255]); 已送 = 真; }
    如果 (長度(乙訊息) >= 3) { 中斷; }
}
印出("甲 / A:", 甲訊息);
印出("乙 / B:", 乙訊息);
甲.關閉();
乙.關閉並說明(4000, "再見");
迴圈 (變數 輪 = 0; 輪 < 50; 輪++) { 通訊.輪詢全部(10); }
印出("伺服器事件 / server events:", 收到, "連線數:", 伺服器.連線數());
變數 成功 = 長度(甲訊息) == 1 && 長度(乙訊息) == 3 && 伺服器.連線數() == 0 && 長度(收到) == 2;
伺服器.關閉();
印出(如果 (成功) { "WEBSOCKET_LOOPBACK_OK"; } 否則 { "WEBSOCKET_LOOPBACK_FAIL"; });
